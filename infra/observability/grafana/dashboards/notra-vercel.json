{
  "uid": "notra-vercel",
  "title": "Notra · Vercel platform",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["notra", "vercel"],
  "links": [
    {
      "title": "Operations",
      "type": "link",
      "url": "/d/notra-overview",
      "keepTime": true
    },
    {
      "title": "API and MCP",
      "type": "link",
      "url": "/d/notra-surfaces",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,preview,development,unattributed",
        "current": { "text": "production", "value": "production" }
      },
      {
        "name": "project",
        "label": "Vercel project ID",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
        "query": "label_values(notra_vercel_metric_window, project_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "metric",
        "label": "Catalog metric",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
        "query": "label_values(notra_vercel_metric_query_success, metric)",
        "refresh": 1,
        "current": {
          "text": "vercel.request.count",
          "value": "vercel.request.count"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Vercel platform telemetry",
      "type": "text",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 5 },
      "options": {
        "mode": "markdown",
        "content": "Connection health below reflects the exporter scrape, catalog API and snapshot freshness. Missing data is not zero. Values represent completed five-minute windows, delayed by at least ten minutes. They are not cumulative counters, customer-level usage or invoices. Function failures can precede application log emission, so compare this dashboard with application events. Empty analytics or Web Vitals charts do not establish collection coverage."
      }
    },
    {
      "id": 2,
      "title": "Vercel collection health",
      "type": "stat",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "text": { "valueSize": 32, "titleSize": 14 }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Scrape|Fresh snapshot|Catalog API)$"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "Unhealthy", "color": "red" },
                      "1": { "text": "Healthy", "color": "green" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"vercel\"}",
          "legendFormat": "Scrape",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "notra_vercel_snapshot_fresh",
          "legendFormat": "Fresh snapshot",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "notra_vercel_catalog_success",
          "legendFormat": "Catalog API",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "notra_vercel_catalog_metrics",
          "legendFormat": "Catalog metrics",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "notra_vercel_supported_metrics",
          "legendFormat": "Supported metrics",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Query coverage (1 = successful, empty may still be normal)",
      "type": "table",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "notra_vercel_query_success",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 200,
      "title": "Vercel metrics · completed five-minute windows",
      "type": "row",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 4,
          "title": "Requests per completed five-minute window",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 10, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.request.count\",aggregation=\"count\",breakdown=\"project\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}}"
            }
          ]
        },
        {
          "id": 5,
          "title": "Function invocations per five-minute window",
          "type": "timeseries",
          "gridPos": { "x": 12, "y": 10, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.function_invocation.count\",aggregation=\"count\",breakdown=\"project\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}}"
            }
          ]
        },
        {
          "id": 6,
          "title": "Function duration p95 / p99",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 17, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "fieldConfig": { "defaults": { "unit": "ms", "min": 0 } },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{breakdown=\"project\",metric=\"vercel.function_invocation.function_duration_ms\",aggregation=~\"p95|p99\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} · {{aggregation}}"
            }
          ]
        },
        {
          "id": 7,
          "title": "Function CPU time (average per invocation)",
          "type": "timeseries",
          "gridPos": { "x": 12, "y": 17, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "fieldConfig": { "defaults": { "unit": "ms", "min": 0 } },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.function_invocation.function_cpu_time_ms\",aggregation=\"avg\",breakdown=\"project\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}}"
            }
          ]
        },
        {
          "id": 8,
          "title": "Function peak memory p95",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 24, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "fieldConfig": { "defaults": { "unit": "decmbytes", "min": 0 } },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.function_invocation.peak_memory_mb\",aggregation=\"p95\",breakdown=\"project\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}}"
            }
          ]
        },
        {
          "id": 9,
          "title": "Requests by HTTP status / method",
          "type": "timeseries",
          "gridPos": { "x": 12, "y": 24, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.request.count\",aggregation=\"count\",breakdown=\"http\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} · {{http_status}} · {{request_method}}"
            }
          ]
        },
        {
          "id": 10,
          "title": "Fast data transfer per five-minute window",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 31, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.request.fdt_total_bytes\",aggregation=\"sum\",breakdown=\"project\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}}"
            }
          ]
        },
        {
          "id": 11,
          "title": "Function runtime / start type",
          "type": "timeseries",
          "gridPos": { "x": 12, "y": 31, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.function_invocation.count\",aggregation=\"count\",breakdown=\"runtime\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} · {{runtime}} · {{function_start_type}}"
            }
          ]
        },
        {
          "id": 12,
          "title": "Request cache outcomes",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 38, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.request.count\",aggregation=\"count\",breakdown=\"cache\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} · {{cache_result}}"
            }
          ]
        },
        {
          "id": 13,
          "title": "AI Gateway reported usage value (not invoices)",
          "type": "timeseries",
          "gridPos": { "x": 12, "y": 38, "w": 12, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "min": 0 } },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{breakdown=\"project\",metric=~\"vercel.ai_gateway.request.(cost|gateway_cost)\",aggregation=\"sum\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} · {{metric}}"
            }
          ]
        },
        {
          "id": 14,
          "title": "Full catalog explorer (native units; includes environment-less metrics)",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 45, "w": 24, "h": 9 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{breakdown=\"project\",metric=\"${metric}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} · {{environment}} · {{aggregation}} · {{unit}}"
            }
          ]
        },
        {
          "id": 15,
          "title": "Catalog query status (includes metrics with no observations)",
          "type": "table",
          "gridPos": { "x": 0, "y": 54, "w": 24, "h": 10 },
          "datasource": { "type": "prometheus", "uid": "notra-prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_query_success",
              "instant": true,
              "format": "table"
            }
          ]
        },
        {
          "id": 16,
          "title": "Function 5xx per completed five-minute window",
          "description": "Platform-reported function invocations with HTTP 5xx, including failures before application logging. An empty series is unknown or has no matching observations. Values are window gauges; do not sum repeated scrapes.",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 64,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "notra-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "min": 0,
              "noValue": "No observations"
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.function_invocation.count\",aggregation=\"count\",breakdown=\"http\",http_status=~\"5..\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} \u00b7 HTTP {{http_status}}"
            }
          ]
        },
        {
          "id": 17,
          "title": "Function time to first byte \u00b7 p95 / p99",
          "description": "Platform TTFB includes background workflow steps and streaming requests. It is not browser performance or authenticated API latency.",
          "type": "timeseries",
          "gridPos": {
            "x": 12,
            "y": 64,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "notra-prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ms",
              "min": 0
            }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "notra_vercel_metric_window{metric=\"vercel.function_invocation.ttfb_ms\",aggregation=~\"p95|p99\",breakdown=\"project\",environment=\"${environment}\",project_id=~\"${project:regex}\"}",
              "legendFormat": "{{project_id}} \u00b7 {{aggregation}}"
            }
          ]
        }
      ]
    }
  ]
}
