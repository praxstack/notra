{
  "name": "@notra/agent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "eve build",
    "dev": "dotenv -e ../../.env -- eve dev --port 3200",
    "agent:dev": "dotenv -e ../../.env -- eve dev",
    "agent:build": "eve build",
    "agent:start": "eve start",
    "check-types": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "agent:dev:devtools": "AI_SDK_DEVTOOLS=true dotenv -e ../../.env -- eve dev",
    "devtools": "bun x @ai-sdk/devtools"
  },
  "dependencies": {
    "@ai-sdk/devtools": "catalog:",
    "@ai-sdk/gateway": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@linear/sdk": "^80.0.0",
    "@notra/ai": "workspace:*",
    "@notra/db": "workspace:*",
    "@notra/posthog": "workspace:*",
    "@notra/tools": "workspace:*",
    "@octokit/core": "^7.0.6",
    "@resvg/resvg-js": "^2.6.2",
    "@upstash/box": "~0.5.5",
    "@upstash/redis": "catalog:",
    "@vercel/oidc": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "echarts": "catalog:",
    "effect": "catalog:",
    "eve": "0.58.1",
    "marked": "^17.0.6",
    "pg": "^8.23.1",
    "sanitize-html": "catalog:",
    "satori": "catalog:",
    "satori-html": "^0.3.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
