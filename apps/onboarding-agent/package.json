{
  "name": "@notra/onboarding-agent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "eve build",
    "dev": "dotenv -e ../../.env -- eve dev --port 3100",
    "agent:dev": "dotenv -e ../../.env -- eve dev",
    "agent:build": "eve build",
    "agent:start": "eve start",
    "check-types": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "agent:dev:devtools": "AI_SDK_DEVTOOLS=true dotenv -e ../../.env -- eve dev",
    "devtools": "bun x @ai-sdk/devtools"
  },
  "dependencies": {
    "@ai-sdk/devtools": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@notra/ai": "workspace:*",
    "@notra/db": "workspace:*",
    "@notra/posthog": "workspace:*",
    "@notra/tools": "workspace:*",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "eve": "0.27.13",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
    "@types/node": "^24.0.15",
    "dotenv-cli": "catalog:",
    "microsandbox": "~0.6.18",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
