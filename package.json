{
  "name": "turbo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/devtools": "1.0.32",
      "@ai-sdk/gateway": "4.0.105",
      "@aws-sdk/client-s3": "^3.1136.0",
      "@base-ui/react": "^1.8.0",
      "@databuddy/sdk": "^2.4.20",
      "@dnd-kit/core": "^6.3.1",
      "@dnd-kit/sortable": "^10.0.0",
      "@electric-sql/pglite": "0.5.8",
      "@hugeicons/core-free-icons": "^4.1.4",
      "@hugeicons/react": "^1.1.10",
      "@tanstack/react-form": "^1.33.5",
      "@types/react-dom": "^19.3.0",
      "@types/sanitize-html": "^2.16.2",
      "@upstash/ratelimit": "^2.1.0",
      "@upstash/redis": "^1.38.4",
      "@vercel/oidc": "^3.8.10",
      "ai": "7.0.129",
      "autumn-js": "~1.2.56",
      "bun-types": "1.4.0",
      "dotenv-cli": "^11.0.0",
      "drizzle-orm": "^0.45.3",
      "echarts": "^6.1.0",
      "effect": "4.0.0",
      "evlog": "2.28.1",
      "lucide-react": "^0.562.0",
      "nanoid": "^5.1.16",
      "next-themes": "^0.4.6",
      "sanitize-html": "^2.17.7",
      "satori": "^0.26.0",
      "sonner": "^2.0.8",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "7.0.2",
      "zod": "^4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "check-types": "dotenv -- turbo run check-types",
    "test": "bun run railway:check && node --test scripts/github/production-deploy.test.mjs && turbo run test",
    "railway:check": "tsc --project .railway/tsconfig.json && bun --no-env-file test ./.railway/tests/config.test.ts infra/observability/railway.test.ts",
    "knip": "dotenv -- turbo run knip --filter=web --filter=dashboard --filter=api",
    "db:generate": "dotenv -- bunx drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:check": "turbo run check:migrations --filter=@notra/db --",
    "db:migrate": "dotenv -- bunx drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:push": "dotenv -- bunx drizzle-kit push --config packages/db/drizzle.config.ts",
    "db:studio": "dotenv -- bunx drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:drop": "dotenv -- bunx drizzle-kit drop --config packages/db/drizzle.config.ts",
    "db:pull": "dotenv -- bunx drizzle-kit pull --config packages/db/drizzle.config.ts",
    "evals": "bun --cwd apps/evals src/index.tsx",
    "devtools:api": "cd apps/api && bunx @ai-sdk/devtools",
    "devtools:dashboard": "cd apps/dashboard && bunx @ai-sdk/devtools",
    "check": "bun run check:effect && ultracite check --threads=4",
    "check:effect": "oxlint --config oxlint.effect.config.ts apps/api/src apps/dashboard/src apps/web/src apps/agent/agent apps/onboarding-agent/agent packages/ai/src packages/analytics/src packages/db/src packages/geo-core/src packages/schemas/src packages/sites-server/src packages/tools/src packages/webhooks/src --threads=2",
    "format": "ultracite fix --threads=4",
    "format:unsafe": "ultracite fix --unsafe --threads=4",
    "commitlint": "commitlint",
    "prepare": "husky && ./scripts/prepare-effect.sh && effect-tsgo patch --typescript --oxlint",
    "brew:setup": "dotenv -- bun packages/email/scripts/brew-setup.ts",
    "brew:test-send": "dotenv -- bun packages/email/scripts/brew-test-send.tsx",
    "brew:previews": "dotenv -- bun packages/email/scripts/brew-previews.tsx"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@effect/tsgo": "0.47.2",
    "@shadcn/lint": "0.1.0",
    "@types/node": "24.13.6",
    "bun-types": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.12.2",
    "openlogs": "~0.0.4",
    "oxfmt": "0.64.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "railway": "3.13.1",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "ultracite": "7.10.8"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "dompurify": "3.4.16",
    "hono": "4.13.12",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "nf3": "0.3.17",
    "protobufjs@7": "7.6.5",
    "seroval": "1.6.8",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@workflow/builders@4.1.13": "patches/@workflow%2Fbuilders@4.1.13.patch",
    "@workflow/nitro@4.1.14": "patches/@workflow%2Fnitro@4.1.14.patch",
    "evlog@2.28.1": "patches/evlog@2.28.1.patch",
    "@tanstack/start-plugin-core@1.171.49": "patches/@tanstack%2Fstart-plugin-core@1.171.49.patch",
    "eve@0.58.1": "patches/eve@0.58.1.patch"
  }
}
